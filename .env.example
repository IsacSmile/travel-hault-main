# Environment Variables for Travel & Hault Web Application

# Database Connection (Neon / Supabase / PostgreSQL)
DATABASE_URL="postgresql://username:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require"

# JWT Secret Key for Admin Authentication
JWT_SECRET="your-super-secret-jwt-key-here"

# Environment Mode
NODE_ENV="production"
